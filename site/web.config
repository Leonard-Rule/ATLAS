<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
            <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
            <mimeMap fileExtension=".sas" mimeType="text/plain" />
            <mimeMap fileExtension=".config" mimeType="application/xml" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:01:00" />
        </staticContent>
    </system.webServer>
</configuration>
